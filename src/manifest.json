{
  "manifest_version": 3,
  "name": "Selector Grabber",
  "version": "0.1.0",
  "description": "Click elements, press Done, copy unique relative XPath selectors for Playwright or Selenium.",
  "minimum_chrome_version": "127",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Grab selectors",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [
    { "resources": ["panel/panel.html"], "matches": ["<all_urls>"] }
  ]
}
