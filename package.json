{
  "name": "selector-grabber",
  "version": "0.1.1",
  "description": "Click elements in Brave or Chrome and copy unique relative XPath selectors for Playwright and Selenium.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:e2e": "node build.mjs --e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
